# Optional Browser UI Provider configuration.
# Copy selected values into your local environment; do not enable a third-party site
# until its automation policy and authorization have been reviewed.

GATEWAY_ENABLE_BROWSER_PROVIDER=false
BROWSER_AUTOMATION_AUTHORIZED=false
BROWSER_SITE_URL=
BROWSER_ALLOWED_DOMAINS=
BROWSER_PROMPT_SELECTOR=
BROWSER_SUBMIT_SELECTOR=
BROWSER_ANSWER_SELECTOR=
BROWSER_STORAGE_STATE_PATH=.local/browser-sessions/default.json
BROWSER_HEADLESS=false
BROWSER_NAVIGATION_TIMEOUT_MS=30000
BROWSER_ACTION_TIMEOUT_MS=10000
BROWSER_REQUEST_TIMEOUT_S=90
BROWSER_REQUESTS_PER_MINUTE=6
BROWSER_MIN_INTERVAL_MS=5000
BROWSER_MAX_CONCURRENCY=1
BROWSER_STOP_ON_CHALLENGE=true
BROWSER_SITES_CONFIG=gateway/browser-sites.json
